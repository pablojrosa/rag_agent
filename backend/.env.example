# OpenAI generation and embeddings
OPENAI_API_KEY="your_openai_key"
OPENAI_MODEL="gpt-4.1-mini"
EMBEDDING_MODEL="text-embedding-3-small"
PROMPT_VERSION="1"

# Existing Pinecone index containing the book passages
PINECONE_API_KEY="your_pinecone_key"
PINECONE_INDEX_NAME="your_index_name"

# Application persistence and frontend origin
DATABASE_URL="postgresql://user:password@localhost:5432/rag_agent"
ALLOWED_ORIGINS="http://localhost:5173"

# Optional telemetry; leave keys empty to run chat without monitoring
LANGFUSE_ENABLED="true"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_TRACING_ENVIRONMENT="development"
# Set the project ID to enable trace links in the dashboard
LANGFUSE_PROJECT_ID=""
LANGFUSE_DATASET_NAME="statistical-learning"

# Provider must match an LLM connection configured in the Langfuse project
LANGFUSE_JUDGE_PROVIDER="OpenAI"
LANGFUSE_JUDGE_MODEL="gpt-4.1-mini"
LANGFUSE_ONLINE_EVAL_SAMPLE_RATE="0.1"
# Empty means all active score definitions; otherwise use comma-separated names
DASHBOARD_SCORE_NAMES=""
